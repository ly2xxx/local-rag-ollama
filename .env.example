# Ollama & LLM Configuration
OLLAMA_MODEL=glm-5.2:cloud
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Redis Memory Checkpointer
REDIS_URL=redis://localhost:6379

# Embedding Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Persisted Chroma vector store for Agentic RAG knowledge bases
CHROMA_PERSIST_DIR=.chroma_agentic

# Fallback knowledge-base namespace when no session/thread scope is supplied
AGENTIC_RAG_NAMESPACE=default_session

# Directories read_local_file may read from (';'-separated on Windows).
# Defaults to the project root plus the system temp dir.
# FILE_TOOL_ROOTS=H:\code\yl\local-rag-ollama;C:\Users\HP\AppData\Local\Temp

# ---------------------------------------------------------------------------
# API tier (Phase 1)
# ---------------------------------------------------------------------------
# Comma-separated "<api-key>:<tenant-id>" pairs. Auth fails CLOSED: with this
# empty, every authenticated endpoint returns 401.
API_KEYS=dev-key-local:tenant_local
AUTH_ENABLED=true

# Upload limit
MAX_UPLOAD_BYTES=26214400

# SSE streaming
SSE_HEARTBEAT_SECONDS=15
SSE_TOKEN_CHUNK_CHARS=24
SSE_OBSERVATION_PREVIEW_BYTES=2048

# Readiness: DESIGN 5.5 treats Redis loss as degradation, but the Phase 1 DoD
# requires /readyz to fail while Redis is down. Set false to prefer degradation.
READYZ_REQUIRE_REDIS=true

# Loads the embedding model at startup so the first request is not slow.
WARM_EMBEDDINGS_ON_STARTUP=true

CORS_ALLOW_ORIGINS=*
LOG_LEVEL=INFO
